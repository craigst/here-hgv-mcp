# Copy to .env.local (gitignored) or set these in the process environment.
# NEVER commit a real key.

# Required: HERE Platform API key. Injected by the MCP gateway from its vault.
HERE_API_KEY=

# Transport: stdio is the default (gateway import). Set a port to use
# Streamable HTTP instead — POST /mcp, GET /health.
# HTTP_PORT=8840
# MCP_HTTP_PORT=8840
# MCP_HTTP_HOST=0.0.0.0
# MCP_TRANSPORT=http            # or stdio
# MCP_STATELESS=false

# HERE client behaviour
# HERE_TIMEOUT_MS=20000
# HERE_MAX_RETRIES=2
# HERE_RETRY_BASE_MS=250

# United Kingdom defaults (change for other markets)
# HERE_DEFAULT_COUNTRY=GBR
# HERE_DEFAULT_LANG=en-GB
# HERE_DEFAULT_CURRENCY=GBP
# HERE_DEFAULT_UNITS=metric

# Where here_map_image writes saved images
# HERE_MAP_OUTPUT_DIR=/tmp/here-hgv-mcp-maps

# Logging: debug|info|warn|error|silent (stderr only)
# HERE_LOG_LEVEL=warn
